  "source_after": "def replace_first(text, needle, replacement):\n    if not needle:\n        raise ValueError(\"Needle cannot be empty\")\n    idx = text.find(needle)\n    if idx == -1:\n        return text\n    return text[:idx] + replacement + text[idx + len(needle):]\n",
