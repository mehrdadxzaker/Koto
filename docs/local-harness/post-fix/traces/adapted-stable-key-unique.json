  "source_after": "def unique_records(records, key):\n    seen = set()\n    result = []\n    for record in records:\n        val = record.get(key)\n        if val is None:\n            raise KeyError(f\"Key '{key}' not found in record\")\n        if val not in seen:\n            seen.add(val)\n            result.append(record)\n    return result\n",
