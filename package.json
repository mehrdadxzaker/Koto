{
  "name": "@mehrdadxzaker/koto",
  "version": "3.0.0-alpha.0",
  "description": "A shared core for commercial and open-source agents to work together.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "koto": "bin/koto.js"
  },
  "types": "./src/core.d.ts",
  "exports": {
    ".": {
      "types": "./src/core.d.ts",
      "import": "./src/core.js"
    }
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node tools/check-scope.js",
    "demo": "node bin/koto.js demo",
    "test:package": "node tools/verify-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehrdadxzaker/Koto.git"
  },
  "homepage": "https://github.com/mehrdadxzaker/Koto#readme",
  "bugs": {
    "url": "https://github.com/mehrdadxzaker/Koto/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "orchestration",
    "multi-agent",
    "cli",
    "koto"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
