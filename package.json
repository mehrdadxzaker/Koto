{
  "name": "@mehrdadz/koto",
  "version": "3.0.0-alpha.3",
  "description": "A shared core for commercial and open-source agents to work together.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "koto": "bin/koto.js"
  },
  "types": "./src/core.d.ts",
  "exports": {
    ".": {
      "types": "./src/core.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node tools/check-scope.js",
    "test": "node --test tools/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehrdadxzaker/Koto.git"
  },
  "homepage": "https://github.com/mehrdadxzaker/Koto#readme",
  "bugs": {
    "url": "https://github.com/mehrdadxzaker/Koto/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "orchestration",
    "multi-agent",
    "cli",
    "koto"
  ]
}
