{
  "schema_version": 2,
  "schemas": [
    "hormuz.client-diagnosis",
    "hormuz.request-explanation",
    "hormuz.policy-proposal",
    "hormuz.model-qualification",
    "hormuz.model-recommendation",
    "hormuz.usage-insights",
    "hormuz.capability-error"
  ],
  "qualification": {
    "suite": "responses-local-smoke-v1",
    "maximum_requests": 4,
    "maximum_output_tokens_per_request": 128,
    "probe_deadline_seconds": 12,
    "route_authorized": false
  },
  "migration": "Client diagnosis v2 requires client-check v1 and runtime-check v1 receipts. Complete diagnosis v1 remains readable without rewriting. Connected-client error v2 preserves legacy failure codes and adds one bound diagnostic; other errors remain v1. Historical qualification and admission are unchanged.",
  "rollback": "Diagnosis output is transient. Older readers must reject v2 diagnosis and errors, or consume the retained v1 output with its original reader. Disconnect before removing the plugin. Qualification and history rollback requirements in the v1 capability fixture remain unchanged.",
  "nested_receipts": {
    "override_diagnosis": {
      "schema_id": "hormuz.client-overrides",
      "schema_version": 1,
      "required_fields": [
        "supported_client_version", "scope", "project_state", "layers", "conflicts",
        "launch_state", "effective_routing", "running_session"
      ]
    },
    "client_check": {
      "schema_id": "hormuz.client-check",
      "schema_version": 1,
      "required_fields": ["reason", "action", "observed_version"]
    },
    "runtime_check": {
      "schema_id": "hormuz.runtime-check",
      "schema_version": 1,
      "required_fields": ["reason", "action"]
    }
  },
  "required_fields": {
    "hormuz.client-diagnosis": [
      "connection", "client_compatibility", "supported_client_version", "configuration_binding",
      "routing_mode", "qualified_local_routes", "model_readiness", "task_completion", "scope",
      "project_overrides", "override_diagnosis", "client_check", "runtime_check", "action"
    ],
    "hormuz.request-explanation": [
      "coverage", "observation", "policy_decision", "fallback", "optimization", "scope"
    ],
    "hormuz.policy-proposal": [
      "changes", "activation", "scope", "budget_basis", "source_preserved",
      "history_consent_transferred", "next_action"
    ],
    "hormuz.model-qualification": [
      "result", "checks", "setup", "recorded_at", "expires_at", "scope", "route_authorized",
      "runtime_binding", "limits", "execution"
    ],
    "hormuz.model-recommendation": [
      "model_alias", "recommendation", "evidence_current", "scope", "system_memory_bytes",
      "model_file_bytes", "inference_memory_fit", "route_authorized", "downloads_started", "evidence_trust"
    ],
    "hormuz.usage-insights": [
      "enabled", "totals", "coverage", "observed_tokens", "observations", "savings_measured",
      "observed_period", "by_model", "by_day"
    ],
    "hormuz.capability-error": ["error"]
  },
  "schema_versions": {
    "hormuz.client-diagnosis": 2,
    "hormuz.request-explanation": 1,
    "hormuz.policy-proposal": 1,
    "hormuz.model-qualification": 2,
    "hormuz.model-recommendation": 1,
    "hormuz.usage-insights": 1,
    "hormuz.capability-error": 1
  }
